<!-- ==================== NCTS-FE CLOCKS ==================== -->
<script>
(function () {
  const iotEl = document.getElementById("clock-iot");
  const sgtEl = document.getElementById("clock-sgt");
  const jstEl = document.getElementById("clock-jst");
  const chstEl = document.getElementById("clock-chst");

  if (!iotEl || !sgtEl || !jstEl || !chstEl) return;

  // Diego Garcia (Indian/Chagos Time)
  const iotFormatter = new Intl.DateTimeFormat([], {
    timeZone: "Indian/Chagos",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: false
  });

  // Singapore (Singapore Time)
  const sgtFormatter = new Intl.DateTimeFormat([], {
    timeZone: "Asia/Singapore",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: false
  });

  // Japan (Asia/Tokyo)
  const jstFormatter = new Intl.DateTimeFormat([], {
    timeZone: "Asia/Tokyo",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: false
  });

    // Guam (Chamorro Standard Time)
  const chstFormatter = new Intl.DateTimeFormat([], {
    timeZone: "Pacific/Guam",
    hour: "2-digit",
    minute: "2-digit",
    second: "2-digit",
    hour12: false
  });

  function tick() {
    const now = new Date();
    iotEl.textContent = iotFormatter.format(now);
    sgtEl.textContent = sgtFormatter.format(now);
    jstEl.textContent = jstFormatter.format(now);
    chstEl.textContent = chstFormatter.format(now);
  }
  tick();
  setInterval(tick, 1000);
})();
</script>

<!-- JavaScript to fetch and display top 3 articles (with auto-load on start) -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const dropdown = document.getElementById("news-source-dropdown");
    const resultsContainer = document.getElementById("news-results");
    const CORS_PROXY = "https://api.rss2json.com/v1/api.json?rss_url=";

    function fetchAndRenderFeed(rssUrl) {
      if (!rssUrl) {
        resultsContainer.innerHTML = "";
        return;
      }

      resultsContainer.innerHTML = '<div class="news-loading">Loading top stories...</div>';

      fetch(CORS_PROXY + encodeURIComponent(rssUrl))
        .then(response => response.json())
        .then(data => {
          if (data.status === "ok") {
            const topArticles = data.items.slice(0, 5);
            let htmlContent = '<ul class="news-articles-list">';

            topArticles.forEach(article => {
              htmlContent +=
                '<li class="news-item">' +
                  '<a href="' + article.link + '" target="_blank" rel="noopener noreferrer" class="news-link">' +
                    article.title +
                  "</a>" +
                "</li>";
            });

            htmlContent += "</ul>";
            resultsContainer.innerHTML = htmlContent;
          } else {
            resultsContainer.innerHTML = '<div class="news-error">Unable to load feed. Please try again.</div>';
          }
        })
        .catch(error => {
          console.error("Fetch error:", error);
          resultsContainer.innerHTML = '<div class="news-error">Network error loading news.</div>';
        });
    }

    dropdown.addEventListener("change", function () {
      fetchAndRenderFeed(this.value);
    });

    if (dropdown.value) {
      fetchAndRenderFeed(dropdown.value);
    }
  });
</script>

<!-- ==================== THEME TOGGLE ==================== -->
<script>
(function () {
  var html = document.documentElement;
  var btn = document.getElementById("theme-toggle");
  if (!btn) return;

  function apply(theme) {
    var isDark = theme === "dark";
    html.classList.toggle("dark-mode", isDark);
    localStorage.setItem("theme", isDark ? "dark" : "light");
    btn.textContent = isDark ? "Light" : "Dark";
    btn.setAttribute("aria-label", isDark ? "Switch to light mode" : "Switch to dark mode");
  }

  apply(localStorage.getItem("theme") === "dark" ? "dark" : "light");

  btn.addEventListener("click", function () {
    apply(html.classList.contains("dark-mode") ? "light" : "dark");
  });
})();
</script>

