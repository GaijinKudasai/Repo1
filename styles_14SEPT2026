/* ============================================================
GLOBAL
============================================================ */
:root {
--ink: #111;
--muted: #646464;
--line: #dedede;
--accent: #205f88;
--bg: #ffffff;
}
* {
box-sizing: border-box;
}

html {
scroll-behavior: smooth;
}


body {
margin: 0;
font-family: system-ui, sans-serif;
background: var(--bg);
color: var(--ink);
}

.page {
max-width: 1100px;
margin: 0 auto;
padding: 20px;
}

/* ==================== TOPBAR ==================== */
/* =======from here========== TOPBAR ==================== */

.topbar {
    width: 100%;
    text-align: center;
    padding-bottom: 10px;
    border-bottom: 1px solid #ccc;
}

/* Logo */
.topbar-logo {
    text-align: center;
    margin-bottom: 10px;
}

.topbar-logo img {
    display: block;
    margin: 0 auto;
}

/* Five text lines */
.topbar-content {
    width: 100%;
}

.topbar-line {
    width: 100%;
    margin: 0;
    padding: 0;
}
/* to here for 5 straight lines/*

.live-date {
font-variant-numeric: tabular-nums;
white-space: nowrap;
color: var(--accent);
font-size: 0.86rem;
font-weight: 600;
margin-top: 4px;
}
/* to here ####### /*

/* ============================================================
HEADER
============================================================ */
.site-header {
border-bottom: 1px solid var(--line);
padding-bottom: 10px;
margin-bottom: 10px;
}

.site-title {
font-size: 2rem;
font-weight: 700;
margin: 0;
}

.home-link {
text-decoration: none;
color: var(--ink);
}

/* ============================================================
MAP SECTION
============================================================ */
.map-section h2 {
font-size: 1.8rem;
font-weight: 700;
margin-bottom: 10px;
}

.map-section p {
color: var(--muted);
margin-bottom: 20px;
}

.map-shell {
position: relative;
width: 100%;
overflow: hidden;
}

.map-shell img {
width: 100%;
height: auto;
display: block;
}

/* ============================================================
SVG OVERLAY + HOTSPOTS
============================================================ */
.map-overlay {
position: absolute;
inset: 0;
width: 100%;
height: 100%;
}

.map-hotspot {
fill: #fff;
fill-opacity: 0.001;
cursor: pointer;
transition: fill-opacity 0.15s ease;
}

.map-hotspot:hover {
fill-opacity: 0.12;
}

.map-hotspot:focus {
fill-opacity: 0.18;
stroke: #111;
stroke-width: 3;
}

/* ============================================================
REGION SUBPAGES
============================================================ */
.region-hero {
width: 100%;
}

.region-image {
display: block;
width: 100%;
max-width: 100%;
height: auto;
}

/* ============================================================
MOBILE
============================================================ */
@media (max-width: 480px) {
.site-title {
font-size: 1.6rem; Ko
}
.map-section h2 {
font-size: 1.5rem;
}
}
