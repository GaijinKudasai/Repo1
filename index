    diegogarcia:    { lat: '-7.3114', lon: '72.4111',  zoom: '5', overlay: 'satellite', label: 'NSF Diego Garcia' }

  };

 

  // Detect which file is being requested in the current URL path

  const currentPath = window.location.pathname.toLowerCase();

 

  // Default to Yokosuka coordinates if no subpage match is found

  let activeBase = BASE_CONFIGS.yokosuka;

 

  // Check URL path against keys

  for (const key in BASE_CONFIGS) {

    if (currentPath.includes(key)) {

      activeBase = BASE_CONFIGS[key];

      break;

    }

  }

 

  // Inject optimized, local, autoplaying radar or satellite frame

  weatherBox.innerHTML = `

    <div class="weather-map-container" style="width: 100%; overflow: hidden; border-radius: 6px;">

      <iframe

        src=https://embed.windy.com/embed2.html?lat=${activeBase.lat}&lon=${activeBase.lon}&width=100%&height=250&zoom=${activeBase.zoom}&level=surface&overlay=${activeBase.overlay}&product=${activeBase.overlay}&menu=&message=&marker=1&calendar=now&play=1&type=map&location=coordinates&metricWind=default&metricTemp=default&radarRange=-1

        style="width: 100%; height: 250px; border: none; background: #1a1a24;"

        loading="lazy"

